# Supabase (server-side)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (client-side, exposed to the browser via VITE_ prefix)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cron job authentication (used by /api/public/cron/recall)
CRON_SECRET=generate-a-random-secret-here

# CORS — comma-separated list of allowed frontend origins (no wildcards)
CORS_ALLOWED_ORIGINS=https://app.neuro-fabric.com,https://neuro-fabric.vercel.app

# ONNX Runtime Web (browser-side inference) — optional overrides
# VITE_ORT_WASM_PATHS: override the default /ort/ path for WASM assets (defaults to "/ort/")
# VITE_ORT_WEBGPU: set to "true" to enable WebGPU execution provider (defaults to "false")

# EEGConformer rollout stage: off | canary | beta | ga (defaults to "off")
AI_EEGCONFORMER_ENABLED=off

# NeuroWeave SDK API key (for /developers concept page code examples only)
# NW_API_KEY=sk-live-...
